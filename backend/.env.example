PORT=5000
MONGO_URI=your_mongodb_atlas_uri_here
NODE_ENV=development

# Signing key for auth tokens. Must be >= 32 chars; the server refuses to
# start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API. Required when
# NODE_ENV=production -- without it CORS would be open to every site.
# e.g. https://dialysis-dashboard.vercel.app
FRONTEND_URL=

# `npm run seed:user` creates one demo account per role -- admin@, doctor@,
# nurse@ and user@ -- all sharing the password below. Only the DOMAIN of
# DEMO_USER_EMAIL is used; the local part is ignored.
# Password must be >= 12 characters.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# Destructive: drops and reseeds every patient and session on server start.
# Leave unset. Use `npm run seed` when you actually want sample data.
# SEED_ON_BOOT=true
